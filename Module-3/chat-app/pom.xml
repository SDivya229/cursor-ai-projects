<!-- Spotless plugin for code formatting -->
<build>
  <plugins>
    <plugin>
      <groupId>com.diffplug.spotless</groupId>
      <artifactId>spotless-maven-plugin</artifactId>
      <version>2.17.5</version>
      <configuration>
        <java>
          <googleJavaFormat/>
        </java>
      </configuration>
      <executions>
        <execution>
          <goals>
            <goal>check</goal>
            <goal>apply</goal>
          </goals>
        </execution>
      </executions>
    </plugin>
  </plugins>
</build> 